{
  "name": "@sebastian-software/agent-bridge",
  "version": "0.0.0",
  "description": "Local harness-to-harness delegation gateway",
  "type": "module",
  "bin": {
    "agent-bridge": "./dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./contract": {
      "types": "./dist/src/contract.d.ts",
      "import": "./dist/src/contract.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "fake-harness": "node scripts/fake-harness.mjs",
    "format": "pnpm exec biome format --write src test scripts",
    "format:check": "pnpm exec biome format src test scripts --reporter=summary",
    "lint": "pnpm exec biome check --formatter-enabled=false --assist-enabled=false src test scripts && node scripts/lint.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test 'dist/test/**/*.test.js'",
    "test:coverage": "pnpm run build && node --test --experimental-test-coverage --test-coverage-lines=75 'dist/test/**/*.test.js'",
    "package:check": "pnpm run build && pnpm pack --dry-run",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:coverage && pnpm run package:check"
  },
  "files": [
    "dist/src",
    "schemas",
    "README.md",
    "docs/cli.md",
    "docs/mcp.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.24.0"
}
