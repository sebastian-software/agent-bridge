{
  "name": "harness-relay",
  "version": "0.5.0",
  "description": "Local harness-to-harness delegation gateway",
  "keywords": [
    "agent",
    "cli",
    "delegation",
    "harness",
    "mcp",
    "relay"
  ],
  "homepage": "https://github.com/sebastian-software/harness-relay#readme",
  "bugs": {
    "url": "https://github.com/sebastian-software/harness-relay/issues"
  },
  "license": "MIT",
  "author": "Sebastian Software GmbH",
  "repository": {
    "type": "git",
    "url": "https://github.com/sebastian-software/harness-relay.git"
  },
  "bin": {
    "harness-relay": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "schemas",
    "README.md",
    "docs/local-models.md",
    "docs/cli.md",
    "docs/contract.md",
    "docs/mcp.md",
    "docs/adapters.md",
    "docs/native-dialogue.md",
    "docs/skills.md",
    "skills"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./contract": {
      "types": "./dist/src/contract.d.ts",
      "import": "./dist/src/contract.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm lint:oxlint && pnpm lint:eslint",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:oxlint": "oxlint -c oxlint.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "pnpm run build && node --test 'dist/test/**/*.test.js'",
    "test:coverage": "pnpm run build && node --test --experimental-test-coverage --test-coverage-lines=75 --test-coverage-branches=65 'dist/test/**/*.test.js'",
    "package:check": "pnpm run build && pnpm pack --dry-run && node scripts/package-optional-smoke.mjs",
    "lint:workflows": "node scripts/check-workflow-pins.mjs",
    "docs:adr-index": "node scripts/check-adr-index.mjs",
    "agent:check": "pnpm lint && pnpm lint:workflows && pnpm format:check && pnpm typecheck && pnpm build && pnpm test",
    "check": "pnpm agent:check && pnpm docs:adr-index && pnpm test:coverage && pnpm package:check",
    "fake-harness": "node scripts/fake-harness.mjs",
    "version:sync": "node scripts/sync-version.mjs"
  },
  "dependencies": {
    "smol-toml": "1.9.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@sebastian-software/standards": "0.13.0",
    "@types/node": "24.19.0",
    "eslint": "^10.11.0",
    "eslint-config-setup": "^0.5.2",
    "jiti": "^2.7.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.8.1"
}
