{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-bridge://schemas/invocation-outcome.schema.json",
  "title": "Agent Bridge invocation outcome",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "invocationId", "status", "content", "artifacts", "effects", "observedIdentity", "policy", "completedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "invocationId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["cancelled", "failed", "interrupted", "succeeded", "timed_out"] },
    "content": { "type": "array", "items": { "$ref": "invocation-request.schema.json#/$defs/content-part" } },
    "artifacts": { "type": "array", "items": { "$ref": "invocation-request.schema.json#/$defs/content-part" } },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "evidence"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["created", "deleted", "modified", "renamed", "unknown"] },
          "evidence": { "enum": ["git-status", "harness-reported"] }
        }
      }
    },
    "observedIdentity": { "type": "object" },
    "policy": { "type": "object" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "durationMs": { "type": "integer", "minimum": 0 },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": { "code": { "type": "string", "minLength": 1 }, "message": { "type": "string", "minLength": 1 } }
    }
  }
}
