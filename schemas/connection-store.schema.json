{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness-relay://schemas/connection-store.schema.json",
  "title": "Harness Relay user-global connection store",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "connections"],
  "properties": {
    "version": { "const": 1 },
    "connections": {
      "type": "array",
      "items": { "$ref": "#/$defs/connection" }
    }
  },
  "$defs": {
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "harness", "nativeContextRef", "revision"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "harness": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "nativeContextRef": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "revision": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    }
  }
}
